# ─── Meta WhatsApp Cloud API ─────────────────────────────────────────────────
# Get these from https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_APP_SECRET=your_app_secret_here

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mawazo:mawazo_password@localhost:5432/mawazo
POSTGRES_USER=mawazo
POSTGRES_PASSWORD=mawazo_password
POSTGRES_DB=mawazo

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Anthropic / Claude API ───────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Telegram Bot API ────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. After deployment, call GET /telegram/set-webhook?url=https://your-railway-url
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_random_secret_string   # optional but recommended

# ─── MTN MoMo API (stub — not functional at MVP) ─────────────────────────────
# Apply at https://momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=your_momo_subscription_key
MOMO_API_USER=your_momo_api_user_uuid
MOMO_API_KEY=your_momo_api_key
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
